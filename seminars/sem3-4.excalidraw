    {
      "id": "BBNnmmmFXCauNf5t8Pczp",
      "type": "text",
      "x": 519.4111170667884,
      "y": 3552.8238885793476,
      "width": 975.8541870117188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGW",
      "roundness": null,
      "seed": 646970070,
      "version": 579,
      "versionNonce": 1166029398,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760789873569,
      "link": null,
      "locked": false,
      "text": "Испытывая небывалый ажиотаж от желания немедлено пререйти к деталям обучения нейросетевых\nмоделей можно забыть о том, что все предыдущие формулы для расчета прямого распостранения \nсигнала не учитывают один из аспектов устройства сумматора персептрона - смещения. Восполним \nэтот недостаток в следующем уравнении:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Испытывая небывалый ажиотаж от желания немедлено пререйти к деталям обучения нейросетевых\nмоделей можно забыть о том, что все предыдущие формулы для расчета прямого распостранения \nсигнала не учитывают один из аспектов устройства сумматора персептрона - смещения. Восполним \nэтот недостаток в следующем уравнении:",
      "autoResize": true,
      "lineHeight": 1.25
    },
