    {
      "id": "bpNoobMd29NQ6J8PFTEUR",
      "type": "text",
      "x": 513.0453269974706,
      "y": 3371.929477213655,
      "width": 962.2083129882812,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGU",
      "roundness": null,
      "seed": 216121226,
      "version": 505,
      "versionNonce": 285157450,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760789310801,
      "link": null,
      "locked": false,
      "text": "Здесь каждая сигма - столбец со значениями сумматоров нейронов от соотвествующего входного\nзначения. Таким образом, за одну матричную операцию можно расчитать не прото проход сигнала\nчерез слой сети, но и рассчитать проходы многих разных сигналов через этот слой. Данное \nсвоство сыграет значительную роль при реализации стохастических алгоритмов обучения.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Здесь каждая сигма - столбец со значениями сумматоров нейронов от соотвествующего входного\nзначения. Таким образом, за одну матричную операцию можно расчитать не прото проход сигнала\nчерез слой сети, но и рассчитать проходы многих разных сигналов через этот слой. Данное \nсвоство сыграет значительную роль при реализации стохастических алгоритмов обучения.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WbTUX7wHcY6HkkSoyp0cW",
      "type": "line",
      "x": 500.4971605784337,
      "y": 3507.040964017108,
      "width": 934.9174605927599,
      "height": 7.699453838110912,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
