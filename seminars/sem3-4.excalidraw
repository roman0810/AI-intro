    {
      "id": "m3ux3bxlIdJzHrMQRYdZl",
      "type": "text",
      "x": 482,
      "y": 1930,
      "width": 838.0166625976562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFH",
      "roundness": null,
      "seed": 1699371851,
      "version": 399,
      "versionNonce": 1357659755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760473868515,
      "link": null,
      "locked": false,
      "text": "Каждая прямая на схеме символизирует связь с собственным весом. Увеличивая\nразмер такой сети этих весов станет очень много и с ними станет неудобно работать.\nРешим эту проблему до того, как она особо обострится:\n\nРассмотрим базовую архитектуру с 2 нейронами",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Каждая прямая на схеме символизирует связь с собственным весом. Увеличивая\nразмер такой сети этих весов станет очень много и с ними станет неудобно работать.\nРешим эту проблему до того, как она особо обострится:\n\nРассмотрим базовую архитектуру с 2 нейронами",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WesVtRktEcQFEsxtsAm0u",
      "type": "text",
      "x": 1479.6240757737255,
      "y": 1544.3811271332136,
      "width": 558.9000244140625,
      "height": 25,
