    {
      "id": "dZ5PFtNgfoc3a_y-mvdeo",
      "type": "text",
      "x": 493.1974611303972,
      "y": 2728.610195302661,
      "width": 861.5333251953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFd",
      "roundness": null,
      "seed": 713863397,
      "version": 377,
      "versionNonce": 157304357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760475210645,
      "link": null,
      "locked": false,
      "text": "Где:\nO - столбец выходных значений слоя;\nsigma - функция активации слоя;\nW - матрица весов связей между входными данными и принимающими нейронами,\nимеет размер NxM, где N - число входных значений, а M - число принимающих нейронов;\nI - столбец входных значений.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Где:\nO - столбец выходных значений слоя;\nsigma - функция активации слоя;\nW - матрица весов связей между входными данными и принимающими нейронами,\nимеет размер NxM, где N - число входных значений, а M - число принимающих нейронов;\nI - столбец входных значений.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
