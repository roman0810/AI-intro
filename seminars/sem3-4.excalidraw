    {
      "id": "Joq21H0jxrLHhWQc_lhzY",
      "type": "text",
      "x": 528.4178442399848,
      "y": 3991.480883712705,
      "width": 993.1875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
